# =============================================================================
# ReachInbox Email Scheduler — backend environment variables
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Where the React dev server runs. Used for CORS + OAuth redirects back to the UI.
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend (used to build OAuth callback URLs).
BACKEND_URL=http://localhost:3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL (business state) — provided by docker compose
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ jobs + distributed rate limiting + session store)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Elasticsearch (email search index)
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_EMAIL_INDEX=emails

# -----------------------------------------------------------------------------
# Worker / scheduler tuning
# -----------------------------------------------------------------------------
# How many emails a single worker process may send at the same time.
WORKER_CONCURRENCY=5
# Minimum enforced gap between two email sends (milliseconds), coordinated in Redis.
MIN_EMAIL_DELAY_MS=2000
# Default hourly cap per sender (can be overridden per scheduling request).
EMAILS_PER_HOUR=50

# -----------------------------------------------------------------------------
# SMTP (Ethereal) — generate real credentials with: npm run ethereal:setup
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReachInbox Scheduler <no-reply@reachinbox.test>"

# -----------------------------------------------------------------------------
# Google OAuth 2.0  (Google Cloud Console -> APIs & Services -> Credentials)
# Authorised redirect URI: http://localhost:3000/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# -----------------------------------------------------------------------------
# Sessions — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
SESSION_SECRET=replace-me-with-a-long-random-string
SESSION_TTL_HOURS=168

# -----------------------------------------------------------------------------
# Slack OAuth 2.0  (api.slack.com/apps -> OAuth & Permissions)
# Redirect URL to register: http://localhost:3000/auth/slack/callback
# -----------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/auth/slack/callback
SLACK_SCOPES=chat:write,channels:read,team:read
# Channel (name or ID) that rate-limit alerts are posted to. Defaults to the
# first channel the bot is a member of if left empty.
SLACK_ALERT_CHANNEL=

# -----------------------------------------------------------------------------
# Admin / demo protection for Bull Board (/admin/queues)
# -----------------------------------------------------------------------------
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Development convenience
# -----------------------------------------------------------------------------
# Lets you use the API before Google OAuth credentials exist: every request is
# attributed to a local dev user (src/auth/dev-auth.ts). Refused when
# NODE_ENV=production. Set to false once real Google login is configured.
DEV_AUTH_BYPASS=false
