# =============================================================================
# ReachInbox Email Scheduler — frontend environment variables
# Copy to `.env.local` (gitignored) if you need to override anything.
#   cp .env.example .env.local
#
# GOOD NEWS: this file can stay mostly empty. Everything below is OPTIONAL,
# because the app calls the API with RELATIVE paths ("/api/emails/scheduled") and
# the Vite dev server proxies them to Express (see vite.config.ts).
# =============================================================================

# -----------------------------------------------------------------------------
# Where the Vite dev server should forward /api and /auth requests.
# This is used by the DEV SERVER, not by the browser, so it can point at a host
# the browser cannot reach (e.g. a container name).
# Default: http://localhost:3000
# -----------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Only set this if the browser must call the API on a DIFFERENT origin than the
# page itself — e.g. the frontend is served from a CDN and the API from
# api.example.com. On a single domain (dev proxy or a reverse proxy in
# production) leave it empty so requests stay relative.
#
# If you do set it, the backend must also allow that origin:
#   FRONTEND_URL  (backend/.env)  -> the origin of this app
# Sessions require credentials, and browsers reject wildcard CORS with them, so
# an explicit origin is mandatory.
# Default: (empty — relative requests through the proxy)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
