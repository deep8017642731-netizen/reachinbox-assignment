{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    /* "bundler" resolution understands package.json `exports` maps (Tailwind 4,
       react-router-dom 7) and is the correct mode for Vite projects. */
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,

    /* Each file must be independently compilable (required by esbuild, which
       Vite uses to transpile). Also forces explicit `import type`. */
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    /* vite/client: import.meta.env typing. node: process.env in vite.config.ts,
       which runs in Node, not the browser. */
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
